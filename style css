/* =====================================================
   DIGITAL SKILLS - MODERN CSS
===================================================== */

:root {

    --navy: #0f172a;
    --navy2: #111827;

    --purple: #7c3aed;
    --purple-light: #a855f7;

    --green: #22c55e;
    --green-light: #4ade80;

    --yellow: #facc15;
    --yellow-light: #fde047;

    --blue: #2563eb;
    --cyan: #06b6d4;

    --white: #ffffff;
    --light: #f8fafc;

    --text: #0f172a;
    --muted: #64748b;

    --border: #e2e8f0;

    --heading-font: "Space Grotesk", sans-serif;
    --body-font: "Inter", sans-serif;
    --display-font: "Poppins", sans-serif;

    --radius: 18px;
}


/* RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
}

body {

    font-family: var(--body-font);

    background:
        radial-gradient(
            circle at 10% 20%,
            rgba(124,58,237,.07),
            transparent 25%
        ),
        radial-gradient(
            circle at 90% 70%,
            rgba(34,197,94,.06),
            transparent 25%
        ),
        var(--light);

    color: var(--text);

    overflow-x: hidden;
}

button,
input,
textarea,
select {
    font-family: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
    color: inherit;
}

.hidden {
    display: none !important;
}


/* =====================================================
   HEADER
===================================================== */

.header {

    height: 74px;

    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    z-index: 1000;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 5%;

    background:
        linear-gradient(
            90deg,
            rgba(15,23,42,.97),
            rgba(49,18,87,.97)
        );

    backdrop-filter: blur(18px);

    border-bottom:
        1px solid
        rgba(255,255,255,.08);
}


/* LOGO */

.logo {

    position: absolute;

    left: 50%;

    transform: translateX(-50%);

    font-family: var(--heading-font);

    font-size: 25px;

    font-weight: 700;
}

.logo span {
    color: white;
}

.logo b {
    color: var(--cyan);
}


/* HEADER RIGHT */

.header-right {

    display: flex;

    align-items: center;

    gap: 12px;
}

.login-link {

    color: white;

    font-size: 14px;

    transition: .3s;
}

.login-link:hover {
    color: var(--yellow);
}

.signup-button {

    padding: 10px 18px;

    color: white;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );

    border-radius: 9px;

    font-weight: 600;

    transition: .3s;
}

.signup-button:hover {

    transform:
        translateY(-2px)
        scale(1.02);

    box-shadow:
        0 10px 25px
        rgba(124,58,237,.3);
}

.hamburger,
.settings-button {

    background: none;

    border: none;

    color: white;

    font-size: 27px;

    transition: .3s;
}

.hamburger:hover,
.settings-button:hover {

    color: var(--yellow);

    transform: scale(1.1);
}


/* SETTINGS */

.settings-dropdown {

    position: absolute;

    right: 4%;

    top: 65px;

    width: 240px;

    padding: 20px;

    background: white;

    border-radius: 14px;

    box-shadow:
        0 25px 60px
        rgba(15,23,42,.25);

    display: none;
}

.settings-dropdown.show {
    display: block;
}

.setting {
    margin-bottom: 15px;
}

.setting:last-child {
    margin-bottom: 0;
}

.setting label {

    display: block;

    font-size: 13px;

    font-weight: 700;

    margin-bottom: 7px;
}

.setting select {

    width: 100%;

    padding: 11px;

    border:
        1px solid
        var(--border);

    border-radius: 8px;

    outline: none;
}


/* =====================================================
   SIDE MENU
===================================================== */

.overlay {

    position: fixed;

    inset: 0;

    z-index: 1100;

    background:
        rgba(0,0,0,.55);

    display: none;
}

.overlay.show {
    display: block;
}

.side-menu {

    position: fixed;

    top: 0;
    left: -320px;

    width: 300px;

    height: 100vh;

    padding: 35px 25px;

    z-index: 1200;

    background:
        linear-gradient(
            160deg,
            #0f172a,
            #32145f,
            #064e3b
        );

    transition: .4s ease;

    box-shadow:
        15px 0 50px
        rgba(0,0,0,.25);
}

.side-menu.open {
    left: 0;
}

.close-menu {

    position: absolute;

    top: 20px;
    right: 22px;

    background: none;

    border: none;

    color: white;

    font-size: 34px;
}

.side-logo {

    font-family: var(--heading-font);

    font-size: 26px;

    font-weight: 700;

    margin-bottom: 60px;
}

.side-logo span {
    color: white;
}

.side-logo b {
    color: var(--cyan);
}

.side-menu nav {

    display: flex;

    flex-direction: column;

    gap: 8px;
}

.side-menu nav a {

    padding: 15px;

    color: #cbd5e1;

    border-radius: 9px;

    transition: .3s;
}

.side-menu nav a:hover {

    color: white;

    background:
        linear-gradient(
            90deg,
            rgba(124,58,237,.4),
            rgba(6,182,212,.15)
        );

    transform:
        translateX(6px);
}


/* =====================================================
   HERO
===================================================== */

.hero {

    min-height: 100vh;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 50px;

    padding:
        130px 8%
        90px;

    overflow: hidden;

    color: white;

    background:
        linear-gradient(
            135deg,
            #0f172a 0%,
            #211044 40%,
            #1e3a8a 72%,
            #064e3b 100%
        );
}


/* PARTICLES */

.particles {

    position: absolute;

    inset: 0;

    opacity: .35;

    background-image:
        radial-gradient(
            white 1px,
            transparent 1px
        );

    background-size: 35px 35px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent
        );
}


/* BLOBS */

.gradient-blob {

    position: absolute;

    border-radius: 50%;

    filter: blur(5px);

    opacity: .5;

    animation:
        blobMove 8s infinite
        alternate ease-in-out;
}

.blob-one {

    width: 300px;
    height: 300px;

    background: var(--purple);

    top: -120px;
    left: -100px;
}

.blob-two {

    width: 260px;
    height: 260px;

    background: var(--green);

    right: -100px;
    top: 20%;

    animation-delay: 1s;
}

.blob-three {

    width: 220px;
    height: 220px;

    background: var(--yellow);

    bottom: -100px;
    left: 35%;

    animation-delay: 2s;
}

@keyframes blobMove {

    from {
        transform: translate(0,0) scale(1);
    }

    to {
        transform:
            translate(40px,-30px)
            scale(1.15);
    }
}


/* HERO CONTENT */

.hero-content {

    position: relative;

    z-index: 5;

    max-width: 680px;
}

.hero-badge {

    display: inline-flex;

    gap: 7px;

    padding: 9px 15px;

    border-radius: 50px;

    background:
        rgba(255,255,255,.1);

    border:
        1px solid
        rgba(255,255,255,.2);

    color: var(--yellow);

    font-size: 13px;

    margin-bottom: 24px;

    font-weight: 600;
}

.hero h1 {

    font-family: var(--display-font);

    font-size:
        clamp(
            48px,
            7vw,
            82px
        );

    line-height: 1.02;

    margin-bottom: 25px;

    letter-spacing: -3px;

    font-style: italic;

    background:
        linear-gradient(
            90deg,
            white,
            #ddd6fe,
            #67e8f9,
            #fde047
        );

    -webkit-background-clip: text;

    -webkit-text-fill-color:
        transparent;
}

.hero p {

    max-width: 590px;

    color: #cbd5e1;

    font-size: 18px;

    line-height: 1.8;

    margin-bottom: 30px;
}

.hero-buttons {

    display: flex;

    gap: 13px;

    flex-wrap: wrap;
}

.primary-button,
.outline-button {

    padding: 14px 24px;

    border-radius: 9px;

    font-weight: 700;

    transition: .3s;
}

.primary-button {

    color: white;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );
}

.primary-button:hover {

    transform: translateY(-3px);

    box-shadow:
        0 15px 35px
        rgba(124,58,237,.4);
}

.outline-button {

    border:
        1px solid
        rgba(255,255,255,.3);

    color: white;
}

.outline-button:hover {

    background: white;

    color: var(--navy);
}

.hero-mini-info {

    display: flex;

    gap: 20px;

    flex-wrap: wrap;

    margin-top: 28px;

    color: #a7f3d0;

    font-size: 13px;

    font-style: italic;
}


/* HERO VISUAL */

.hero-visual {

    width: 420px;

    height: 420px;

    position: relative;

    z-index: 3;

    display: flex;

    align-items: center;

    justify-content: center;
}

.hero-logo-circle {

    width: 260px;

    height: 260px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        conic-gradient(
            var(--purple),
            var(--cyan),
            var(--green),
            var(--yellow),
            var(--purple)
        );

    box-shadow:
        0 0 90px
        rgba(168,85,247,.35);

    animation:
        rotateGlow 10s linear infinite;
}

.hero-logo-circle::after {

    content: "";

    position: absolute;

    width: 225px;

    height: 225px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            #111827,
            #312e81
        );
}

.hero-logo-circle span {

    position: relative;

    z-index: 5;

    font-family:
        var(--heading-font);

    font-size: 70px;

    font-weight: 700;

    color: white;
}

@keyframes rotateGlow {

    from {
        transform: rotate(0);
    }

    to {
        transform: rotate(360deg);
    }
}

.glow-ring {

    position: absolute;

    width: 340px;

    height: 340px;

    border-radius: 50%;

    border:
        1px dashed
        rgba(255,255,255,.3);

    animation:
        spin 20s linear infinite;
}

@keyframes spin {

    to {
        transform: rotate(360deg);
    }
}

.floating-card {

    position: absolute;

    z-index: 8;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 13px 16px;

    background:
        rgba(255,255,255,.1);

    border:
        1px solid
        rgba(255,255,255,.2);

    backdrop-filter: blur(15px);

    border-radius: 13px;

    animation:
        floating 4s ease-in-out infinite;
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card small {
    color: #cbd5e1;
}

.float-one {
    top: 35px;
    left: -10px;
}

.float-two {
    right: -10px;
    bottom: 45px;

    animation-delay: 1s;
}

.float-three {
    bottom: -10px;
    left: 45px;

    animation-delay: 2s;
}

@keyframes floating {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}


/* =====================================================
   GENERAL SECTIONS
===================================================== */

.section {

    padding:
        100px 7%;
}

.section-title {

    max-width: 800px;

    margin-bottom: 55px;
}

.section-title.center {

    text-align: center;

    margin-left: auto;
    margin-right: auto;
}

.tag {

    color: var(--purple);

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 2px;
}

.section-title h2 {

    font-family:
        var(--heading-font);

    font-size:
        clamp(34px,5vw,52px);

    margin:
        10px 0 18px;
}

.section-title p {

    color: var(--muted);

    line-height: 1.8;
}


/* =====================================================
   ABOUT
===================================================== */

.about-section {

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #f5f3ff,
            #f0fdf4
        );
}

.about-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 25px;
}

.about-card {

    padding: 35px;

    border-radius:
        var(--radius);

    transition: .3s;

    border: 1px solid transparent;
}

.about-card:hover {

    transform:
        translateY(-8px);

    box-shadow:
        0 25px 50px
        rgba(15,23,42,.1);
}

.purple-card {

    background:
        linear-gradient(
            135deg,
            #f5f3ff,
            #ede9fe
        );

    border-color: #ddd6fe;
}

.green-card {

    background:
        linear-gradient(
            135deg,
            #f0fdf4,
            #dcfce7
        );

    border-color: #bbf7d0;
}

.yellow-card {

    background:
        linear-gradient(
            135deg,
            #fefce8,
            #fef3c7
        );

    border-color: #fde68a;
}

.about-icon {

    font-size: 40px;

    margin-bottom: 20px;
}

.about-card h3 {

    font-family:
        var(--heading-font);

    font-size: 24px;

    margin-bottom: 10px;
}

.about-card p {

    color: var(--muted);

    line-height: 1.7;
}


/* =====================================================
   AUTH
===================================================== */

.auth-section {

    background:
        linear-gradient(
            135deg,
            #ede9fe,
            #f0fdf4,
            #fefce8
        );
}

.auth-box {

    max-width: 500px;

    margin: auto;

    padding: 40px;

    border-radius:
        var(--radius);

    background: white;

    box-shadow:
        0 30px 70px
        rgba(15,23,42,.1);
}

.tabs {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 5px;

    padding: 5px;

    background: #f1f5f9;

    border-radius: 10px;

    margin-bottom: 25px;
}

.tab {

    border: none;

    background: transparent;

    padding: 12px;

    border-radius: 7px;

    font-weight: 700;

    color: var(--muted);
}

.tab.active {

    color: white;

    background:
        linear-gradient(
            135deg,
            var(--purple),
            var(--blue)
        );
}

.auth-form {

    display: flex;

    flex-direction: column;

    gap: 16px;
}

.input-group label {

    display: block;

    font-size: 13px;

    font-weight: 700;

    margin-bottom: 7px;
}

.input-group input,
.input-group textarea {

    width: 100%;

    padding: 13px 14px;

    border:
        1px solid
        var(--border);

    border-radius: 9px;

    outline: none;

    transition: .3s;
}

.input-group input:focus,
.input-group textarea:focus {

    border-color:
        var(--purple);

    box-shadow:
        0 0 0 4px
        rgba(124,58,237,.1);
}

.remember {

    display: flex;

    gap: 8px;

    align-items: center;

    font-size: 13px;
}

.submit-button {

    width: 100%;

    padding: 14px;

    border: none;

    border-radius: 9px;

    color: white;

    font-weight: 700;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );

    transition: .3s;
}

.submit-button:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 12px 30px
        rgba(37,99,235,.25);
}

.message {

    text-align: center;

    font-size: 13px;
}


/* =====================================================
   COURSES
===================================================== */

.courses-section {

    background:
        linear-gradient(
            135deg,
            #f8fafc,
            #faf5ff,
            #f0fdf4
        );
}

.courses-grid {

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 25px;
}

.course-card {

    overflow: hidden;

    background: white;

    border-radius:
        var(--radius);

    border:
        1px solid
        var(--border);

    transition: .3s;
}

.course-card:hover {

    transform:
        translateY(-8px);

    box-shadow:
        0 25px 55px
        rgba(15,23,42,.12);
}

.course-image {

    width: 100%;

    height: 200px;

    object-fit: cover;

    display: block;
}

.course-body {

    padding: 22px;
}

.course-body h3 {

    font-family:
        var(--heading-font);

    font-size: 20px;

    margin-bottom: 10px;
}

.course-body p {

    color: var(--muted);

    font-size: 14px;

    line-height: 1.7;

    min-height: 48px;
}

.course-time {

    display: block;

    margin:
        15px 0;

    color:
        var(--green);

    font-size: 13px;

    font-weight: 800;

    font-style: italic;
}

.course-button {

    display: block;

    text-align: center;

    padding: 11px;

    border-radius: 8px;

    color: white;

    background:
        linear-gradient(
            135deg,
            var(--blue),
            var(--purple)
        );

    transition: .3s;
}

.course-button:hover {

    transform: scale(1.02);
}


/* =====================================================
   ADMIN
===================================================== */

.admin-section {

    background:
        linear-gradient(
            135deg,
            #ede9fe,
            #dcfce7,
            #fef3c7
        );
}

.admin-container {

    max-width: 1200px;

    margin: auto;
}

.admin-login {

    max-width: 500px;

    margin: auto;

    background: white;

    padding: 40px;

    border-radius:
        var(--radius);

    box-shadow:
        0 30px 70px
        rgba(15,23,42,.1);
}

.admin-top {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 30px;
}

.admin-top h2 {

    font-family:
        var(--heading-font);

    font-size: 38px;
}

.logout-button {

    border: none;

    padding: 11px 20px;

    border-radius: 8px;

    color: white;

    background: #dc2626;

    font-weight: 700;
}

.stats {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 20px;

    margin-bottom: 25px;
}

.stat {

    padding: 25px;

    border-radius:
        var(--radius);

    display: flex;

    gap: 18px;

    align-items: center;
}

.purple-stat {

    background:
        linear-gradient(
            135deg,
            #ede9fe,
            #ddd6fe
        );
}

.green-stat {

    background:
        linear-gradient(
            135deg,
            #dcfce7,
            #bbf7d0
        );
}

.stat > span {

    font-size: 40px;
}

.stat small,
.stat strong {
    display: block;
}

.stat small {
    color: var(--muted);
}

.stat strong {

    font-family:
        var(--heading-font);

    font-size: 32px;
}

.admin-card {

    background: white;

    padding: 25px;

    border-radius:
        var(--radius);

    margin-bottom: 25px;
}

.admin-card h3 {

    font-family:
        var(--heading-font);

    font-size: 23px;

    margin-bottom: 20px;
}

.table-container {

    overflow-x: auto;
}

table {

    width: 100%;

    border-collapse: collapse;

    min-width: 600px;
}

th,
td {

    padding: 13px;

    text-align: left;

    border-bottom:
        1px solid
        var(--border);

    font-size: 13px;
}

th {

    background: #f8fafc;

    font-family:
        var(--heading-font);
}

.delete-btn,
.edit-btn {

    border: none;

    padding: 7px 11px;

    color: white;

    border-radius: 6px;

    font-size: 12px;

    margin-right: 4px;
}

.delete-btn {
    background: #dc2626;
}

.edit-btn {
    background: var(--blue);
}

.course-form {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 15px;

    margin-bottom: 30px;
}

.full {
    grid-column: 1 / -1;
}


/* =====================================================
   FOOTER
===================================================== */

.footer {

    position: relative;

    overflow: hidden;

    padding:
        75px 7% 25px;

    color: white;

    text-align: center;

    background:
        linear-gradient(
            135deg,
      
